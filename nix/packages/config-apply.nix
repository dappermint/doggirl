{
  lib,
  writeShellApplication,
  coreutils,
  jq,
}:

writeShellApplication {
  name = "doggirl-config-apply";
  runtimeInputs = [
    coreutils
    jq
  ];
  text = ''
    set -euo pipefail

    usage() {
      cat <<'EOF'
    usage: doggirl-config-apply --manifest FILE --home DIR [options]

    options:
      --manifest FILE          JSON manifest generated by the doggirl Nix module
      --home DIR               Target user's home directory
      --config-base DIR        Override config base directory
      --data-base DIR          Override data base directory
      --mode MODE              One of: overwrite, merge, symlink (default: overwrite)
      --backup                 Keep a .bak copy before overwriting unmanaged files
      --no-backup              Do not create .bak backups
      --owner USER             Chown written directories and files to USER (when root)
      --group GROUP            Chown group alongside --owner
    EOF
    }

    manifest=""
    target_home=""
    config_base=""
    data_base=""
    mode="overwrite"
    backup="1"
    owner=""
    group=""

    while [ "$#" -gt 0 ]; do
      case "$1" in
        --manifest)
          manifest="$2"
          shift 2
          ;;
        --home)
          target_home="$2"
          shift 2
          ;;
        --config-base)
          config_base="$2"
          shift 2
          ;;
        --data-base)
          data_base="$2"
          shift 2
          ;;
        --mode)
          mode="$2"
          shift 2
          ;;
        --backup)
          backup="1"
          shift
          ;;
        --no-backup)
          backup="0"
          shift
          ;;
        --owner)
          owner="$2"
          shift 2
          ;;
        --group)
          group="$2"
          shift 2
          ;;
        -h|--help)
          usage
          exit 0
          ;;
        *)
          echo "doggirl-config-apply: unknown argument '$1'" >&2
          usage >&2
          exit 2
          ;;
      esac
    done

    if [ -z "$manifest" ] || [ -z "$target_home" ]; then
      echo "doggirl-config-apply: --manifest and --home are required" >&2
      exit 2
    fi

    case "$mode" in
      overwrite|merge|symlink) ;;
      *)
        echo "doggirl-config-apply: invalid mode '$mode' (expected overwrite, merge, or symlink)" >&2
        exit 2
        ;;
    esac

    if [ -z "$config_base" ]; then
      if [ "$(uname -s)" = "Darwin" ]; then
        config_base="$target_home/Library/Preferences"
      else
        config_base="$target_home/.config"
      fi
    fi

    if [ -z "$data_base" ]; then
      if [ "$(uname -s)" = "Darwin" ]; then
        data_base="$target_home/Library/Application Support"
      else
        data_base="$target_home/.local/share"
      fi
    fi

    apply_ownership() {
      local path="$1"
      if [ -n "$owner" ] && [ "$(id -u)" -eq 0 ]; then
        if [ -n "$group" ]; then
          chown -h "$owner:$group" "$path"
        else
          chown -h "$owner" "$path"
        fi
      fi
    }

    ensure_parent_chain() {
      local target="$1"
      local stop_at="$2"
      local perm="$3"
      mkdir -p "$target"
      local cur="$target"
      while [ "$cur" != "$stop_at" ] && [ "$cur" != "/" ] && [ "$cur" != "." ]; do
        chmod "$perm" "$cur"
        apply_ownership "$cur"
        cur="$(dirname "$cur")"
      done
    }

    install_json_file() {
      local src="$1"
      local dst="$2"
      local merge_supported="$3"

      if [ "$mode" = "symlink" ]; then
        if [ "$backup" = "1" ] && [ -e "$dst" ] && [ ! -L "$dst" ]; then
          cp -p "$dst" "$dst.bak"
          apply_ownership "$dst.bak"
        fi
        local tmp_link
        tmp_link="$(mktemp "$(dirname "$dst")/.doggirl-link.XXXXXX")"
        rm -f "$tmp_link"
        ln -s "$src" "$tmp_link"
        apply_ownership "$tmp_link"
        mv -f "$tmp_link" "$dst"
        return 0
      fi

      local tmp_file
      tmp_file="$(mktemp "$(dirname "$dst")/.doggirl-tmp.XXXXXX")"

      if [ "$mode" = "merge" ] && [ "$merge_supported" = "1" ] && [ -f "$dst" ]; then
        if jq -e 'type == "object"' "$dst" >/dev/null 2>&1; then
          jq -s '.[0] * .[1]' "$dst" "$src" > "$tmp_file"
        else
          jq '.' "$src" > "$tmp_file"
        fi
      else
        jq '.' "$src" > "$tmp_file"
      fi

      if [ "$backup" = "1" ] && [ -f "$dst" ] && [ ! -L "$dst" ]; then
        if ! cmp -s "$tmp_file" "$dst"; then
          cp -p "$dst" "$dst.bak"
          apply_ownership "$dst.bak"
        fi
      fi

      chmod 0600 "$tmp_file"
      apply_ownership "$tmp_file"
      mv -f "$tmp_file" "$dst"
    }

    install_raw_file() {
      local src="$1"
      local dst="$2"

      if [ "$mode" = "symlink" ]; then
        local tmp_link
        tmp_link="$(mktemp "$(dirname "$dst")/.doggirl-link.XXXXXX")"
        rm -f "$tmp_link"
        ln -s "$src" "$tmp_link"
        apply_ownership "$tmp_link"
        mv -f "$tmp_link" "$dst"
        return 0
      fi

      local tmp_file
      tmp_file="$(mktemp "$(dirname "$dst")/.doggirl-tmp.XXXXXX")"
      cp "$src" "$tmp_file"
      chmod 0600 "$tmp_file"
      apply_ownership "$tmp_file"
      mv -f "$tmp_file" "$dst"
    }

    profile_count="$(jq 'length' "$manifest")"
    idx=0
    while [ "$idx" -lt "$profile_count" ]; do
      name="$(jq -r ".[$idx].name" "$manifest")"
      custom_path="$(jq -r ".[$idx].customPath // empty" "$manifest")"
      settings_src="$(jq -r ".[$idx].settingsFile" "$manifest")"
      permissions_src="$(jq -r ".[$idx].permissionsFile // empty" "$manifest")"
      bookmarks_src="$(jq -r ".[$idx].bookmarksFile // empty" "$manifest")"

      if [ -n "$custom_path" ]; then
        profile_config_dir="$custom_path/config"
        profile_data_dir="$custom_path/data"
        ensure_parent_chain "$profile_config_dir" "$(dirname "$custom_path")" 0700
        ensure_parent_chain "$profile_data_dir" "$(dirname "$custom_path")" 0700
      else
        profile_config_dir="$config_base/Doggirl/Profiles/$name"
        profile_data_dir="$data_base/Doggirl/Profiles/$name"
        ensure_parent_chain "$profile_config_dir" "$config_base" 0700
        ensure_parent_chain "$profile_data_dir" "$data_base" 0700
      fi

      install_json_file "$settings_src" "$profile_config_dir/Settings.json" "1"

      if [ -n "$permissions_src" ]; then
        install_json_file "$permissions_src" "$profile_config_dir/Permissions.json" "0"
      fi

      if [ -n "$bookmarks_src" ]; then
        install_json_file "$bookmarks_src" "$profile_config_dir/Bookmarks.json" "0"
      fi

      list_count="$(jq ".[$idx].localListFiles | length" "$manifest")"
      if [ "$list_count" -gt 0 ]; then
        lists_dir="$profile_data_dir/ContentBlocking/Lists"
        ensure_parent_chain "$lists_dir" "$profile_data_dir" 0700
        lidx=0
        while [ "$lidx" -lt "$list_count" ]; do
          list_id="$(jq -r ".[$idx].localListFiles[$lidx].identifier" "$manifest")"
          list_src="$(jq -r ".[$idx].localListFiles[$lidx].source" "$manifest")"
          install_raw_file "$list_src" "$lists_dir/$list_id.txt"
          lidx=$((lidx + 1))
        done
      fi

      idx=$((idx + 1))
    done
  '';

  meta = {
    description = "Apply declarative doggirl browser profile configurations";
    mainProgram = "doggirl-config-apply";
    platforms = lib.platforms.unix;
  };
}
