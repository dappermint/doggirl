<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2025-present, the Ladybird developers. -->
<component type="desktop-application">
  <id>org.ladybird.Ladybird</id>

  <name>Doggirl</name>
  <summary>Fast, independent web browser</summary>

  <developer id="dev.dappermint">
    <name>dappermint</name>
  </developer>

  <url type="homepage">https://github.com/dappermint/doggirl</url>
  <url type="bugtracker">https://github.com/dappermint/doggirl/issues</url>
  <url type="vcs-browser">https://github.com/dappermint/doggirl</url>

  <metadata_license>0BSD</metadata_license>
  <project_license>BSD-2-Clause</project_license>
  <content_rating type="oars-1.1" />

  <description>
    <p>
      Doggirl is an independent web browser built on an original standards-first web engine, focused on speed, stability and declarative configuration.
    </p>
  </description>

  <provides>
    <mediatype>text/html</mediatype>
    <mediatype>text/xml</mediatype>
    <mediatype>application/xhtml+xml</mediatype>
    <mediatype>x-scheme-handler/http</mediatype>
    <mediatype>x-scheme-handler/https</mediatype>
  </provides>

  <launchable type="desktop-id">org.ladybird.Ladybird.desktop</launchable>
  <releases>
    <release version="@METAINFO_RELEASE_VERSION@" type="@METAINFO_RELEASE_TYPE@" date="@DATE@">
      <description>
        <p>
          @METAINFO_RELEASE_DESCRIPTION@
        </p>
      </description>
    </release>
  </releases>

  <branding>
    <color type="primary" scheme_preference="light">#9d7cf2</color>
    <color type="primary" scheme_preference="dark">#8a64e5</color>
  </branding>

</component>
